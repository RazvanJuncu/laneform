{
  "version": 8,
  "name": "Glide / Deep Current",
  "metadata": {
    "glide:source": "https://github.com/hyperknot/openfreemap-styles/tree/main/styles/dark",
    "glide:purpose": "Low-distraction road hierarchy for route guidance",
    "glide:palette": "Cool blue-black, deep teal, silver-gray, signal lime"
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a> · © OpenMapTiles · OpenFreeMap"
    }
