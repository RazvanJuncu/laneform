      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#071018"
      },
      "layout": {}
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "all",
        [
          "match",
          [
            "geometry-type"
          ],
          [
            "MultiPolygon",
            "Polygon"
          ],
          true,
          false
        ],
        [
          "!=",
          [
            "get",
            "brunnel"
          ],
          "tunnel"
        ]
      ],
      "paint": {
        "fill-antialias": false,
        "fill-color": "#0E2230"
      },
      "layout": {}
    },
    {
